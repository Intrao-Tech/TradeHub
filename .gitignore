# Dependencies
node_modules/

# Build
dist/
build/

# Environment — real secrets NEVER committed. Only .env.example is tracked.
.env
.env.local
.env.*.local
.env.dev
.env.prod
# .env.production IS committed for frontend (just a URL)

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Prisma
backend/prisma/migrations/**/migration_lock.toml

# Local pg_dump output — schema source-of-truth is Prisma migrations.
backend/*.sql

# Ad-hoc dev/debug scripts (db dumps, ad-hoc one-shot probes). Application
# scripts that need to ship belong somewhere else (e.g. backend/src/scripts).
backend/scripts/

# Working DB artifacts inside a tasks/<feature>/ folder. The schema source-
# of-truth is Prisma migrations + DATA-MODEL.md; per-feature DDL dumps are
# scratchpads, not specs.
tasks/**/db-current.sql
tasks/**/db-schema-proposal.sql

# Docker
docker-data/

# Uploaded files (local dev)
uploads/

# PDF renders from analysis (not needed in repo)
page_*.png

# Docs / specs (keep locally, not in repo)
*.docx
*.pdf
*.doc

# Local dev / planning notes (not for the repo)
.dev-notes/

# Local generated artifacts from dev/analysis sessions — keep locally, never
# commit. Schema source-of-truth is the Prisma migrations; the *.pdf rule above
# already covers tradehub-pds.pdf.
/current-schema.sql
/tradehub-pds.html

# TypeScript incremental build cache (emitted by `tsc --build`)
*.tsbuildinfo
