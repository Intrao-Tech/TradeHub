# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://tradehub:tradehub_dev@localhost:5433/tradehub?schema=public"

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Google OAuth (leave empty to disable) ────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:8081/api/auth/google/callback"

# ── Stripe (leave empty = escrow stubbed) ────────────
STRIPE_SECRET_KEY=""
# webhook secret from: platform destination ("Your account") or Stripe CLI
STRIPE_WEBHOOK_SECRET=""
# webhook secret from: Connect destination ("Connected and v2 accounts")
STRIPE_CONNECT_WEBHOOK_SECRET=""

# ── Email ────────────────────────────────────────────
# Pick how email goes out: `smtp` uses nodemailer (gmail / mailtrap / any SMTP
# host); `http` uses Resend's HTTP API (HTTPS — required on hosts that block
# outbound SMTP, e.g. Railway Hobby). Default = smtp.
MAIL_TRANSPORT="smtp"

# Path 1 — MAIL_TRANSPORT=http (Resend HTTP API)
RESEND_API_KEY=""
# Sender address used by Resend. Without a verified domain in Resend you can
# only use `onboarding@resend.dev` and can only send to the account owner's
# email. Verify a domain to send `noreply@yourdomain.com` to anyone.
RESEND_FROM="onboarding@resend.dev"

# Path 2 — MAIL_TRANSPORT=smtp (nodemailer)
# For Gmail: enable 2FA on the account → create an App Password
# (https://myaccount.google.com/apppasswords) and put the 16-char string into
# SMTP_PASS (spaces are stripped automatically).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Files ────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ── Redis (leave empty = in-memory WS, single instance) ──
REDIS_URL="redis://localhost:6379"

# ── Frontend (for OAuth redirects + CORS) ────────────
FRONTEND_URL="http://localhost:3000"

# ── Staff subdomain (AUTH-016) ───────────────────────
# In dev, internal.localhost:3000 resolves to 127.0.0.1 per RFC 6761.
# In prod set to internal.tradehub.co.uk / https://internal.tradehub.co.uk
STAFF_LOGIN_HOST="internal.localhost"
STAFF_FRONTEND_URL="http://internal.localhost:3000"

# ── Server ───────────────────────────────────────────
PORT=8081
NODE_ENV=development
