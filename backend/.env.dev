# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://tradehub:tradehub_dev@localhost:5433/tradehub?schema=public"

# ── Auth ─────────────────────────────────────────────
JWT_SECRET="tradehub-dev-jwt-secret-change-in-prod"
JWT_REFRESH_SECRET="tradehub-dev-refresh-secret-change-in-prod"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Google OAuth (leave empty to disable) ────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:8081/api/auth/google/callback"

# ── Stripe (leave empty = escrow stubbed) ────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (leave empty = no emails sent) ─────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@tradehub.co.uk"

# ── Files ────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ── Redis (leave empty = in-memory WS, single instance) ──
REDIS_URL="redis://localhost:6379"

# ── Server ───────────────────────────────────────────
PORT=8081
NODE_ENV=development
