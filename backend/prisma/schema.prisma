generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 1. ACCOUNT (auth base for everyone)
// ============================================

model Account {
  id                BigInt    @id @default(autoincrement())
  email             String    @unique @db.VarChar(255)
  password_hash     String?   @db.VarChar(255)
  google_id         String?   @unique @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  phone_verified    Boolean   @default(false)
  status            String    @default("PENDING_EMAIL_VERIFICATION") @db.VarChar(30)
  email_verified_at DateTime? @db.Timestamptz()
  referral_code     String    @unique @db.VarChar(16)
  referred_by_id    BigInt?
  referred_at       DateTime? @db.Timestamptz()
  created_at        DateTime  @default(now()) @db.Timestamptz()
  updated_at        DateTime  @updatedAt @db.Timestamptz()
  last_login_at     DateTime? @db.Timestamptz()

  client_profile            ClientProfile?
  staff_member              StaffMember?
  refresh_tokens            RefreshToken[]
  notifications             Notification[]
  audit_logs                AuditLog[]
  conversation_participants ConversationParticipant[]
  email_verification_tokens EmailVerificationToken[]
  password_reset_tokens     PasswordResetToken[]

  referrer              Account?         @relation("AccountReferrer", fields: [referred_by_id], references: [id])
  referred_accounts     Account[]        @relation("AccountReferrer")
  job_application_refs  JobApplication[] @relation("ApplicationProjectReferrer")
  contract_project_refs Contract[]       @relation("ContractProjectReferrer")

  @@index([status])
  @@index([referral_code])
  @@index([referred_by_id])
  @@map("account")
}

// ============================================
// 2A. EMAIL VERIFICATION TOKEN
// ============================================

model EmailVerificationToken {
  id          BigInt    @id @default(autoincrement())
  account_id  BigInt
  token_hash  String    @unique @db.VarChar(64)
  expires_at  DateTime  @db.Timestamptz()
  consumed_at DateTime? @db.Timestamptz()
  created_at  DateTime  @default(now()) @db.Timestamptz()

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@map("email_verification_token")
}

// ============================================
// 2B. PASSWORD RESET TOKEN
// ============================================

model PasswordResetToken {
  id          BigInt    @id @default(autoincrement())
  account_id  BigInt
  token_hash  String    @unique @db.VarChar(64)
  expires_at  DateTime  @db.Timestamptz()
  consumed_at DateTime? @db.Timestamptz()
  created_at  DateTime  @default(now()) @db.Timestamptz()

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@map("password_reset_token")
}

// ============================================
// 2. REFRESH TOKEN
// ============================================

model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  account_id BigInt
  token      String   @unique @db.VarChar(500)
  expires_at DateTime @db.Timestamptz()
  created_at DateTime @default(now()) @db.Timestamptz()

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@map("refresh_token")
}

// ============================================
// 3. CLIENT PROFILE (shared PK = account.id)
// ============================================

model ClientProfile {
  id                         BigInt   @id
  display_name               String   @db.VarChar(150)
  slug                       String   @unique @db.VarChar(150)
  avatar_url                 String?  @db.VarChar(500)
  bio                        String?
  city                       String?  @db.VarChar(100)
  postcode_area              String?  @db.VarChar(10)
  verification_level         String   @default("UNVERIFIED") @db.VarChar(30)
  stripe_connect_account_id  String?  @db.VarChar(200)
  stripe_onboarding_complete Boolean  @default(false)
  connect_charges_enabled    Boolean  @default(false)
  connect_payouts_enabled    Boolean  @default(false)
  created_at                 DateTime @default(now()) @db.Timestamptz()
  updated_at                 DateTime @updatedAt @db.Timestamptz()

  account          Account          @relation(fields: [id], references: [id], onDelete: Cascade)
  worker_profile   WorkerProfile?
  employer_profile EmployerProfile?

  documents               Document[]
  verification_milestones VerificationMilestone[]
  user_subscriptions      UserSubscription[]
  job_attachments         JobAttachment[]
  message_attachments     MessageAttachment[]
  filed_disputes          EscrowDispute[]         @relation("DisputeFiler")
  pending_referral_payouts PendingReferralPayout[] @relation("ReferralPayoutReferrer")
  pending_worker_payouts   PendingWorkerPayout[]   @relation("WorkerPayoutWorker")
  milestone_attachments    EscrowMilestoneAttachment[] @relation("MilestoneAttachmentUploader")

  @@index([postcode_area])
  @@map("client_profile")
}

// ============================================
// 4. WORKER PROFILE (shared PK = client_profile.id)
// ============================================

model WorkerProfile {
  id               BigInt    @id
  years_experience Int?      @db.SmallInt
  day_rate_min     Decimal?  @db.Decimal(8, 2)
  day_rate_max     Decimal?  @db.Decimal(8, 2)
  available_from   DateTime? @db.Timestamptz()
  is_available     Boolean   @default(true)
  rating_avg       Decimal   @default(0) @db.Decimal(3, 2)
  rating_count     Int       @default(0)
  languages        String[]  @default([]) // ISO 639-1 codes, PROF-055
  created_at       DateTime  @default(now()) @db.Timestamptz()
  updated_at       DateTime  @updatedAt @db.Timestamptz()

  client_profile ClientProfile @relation(fields: [id], references: [id], onDelete: Cascade)

  worker_specialisations   WorkerSpecialisation[]
  portfolio_items          PortfolioItem[]
  collaborations_as_worker Collaboration[]        @relation("CollabWorker")
  worker_tags              WorkerTag[]
  job_applications         JobApplication[]

  @@index([is_available, available_from])
  @@index([rating_avg(sort: Desc), rating_count(sort: Desc)])
  @@map("worker_profile")
}

// ============================================
// 5. EMPLOYER PROFILE (shared PK = client_profile.id)
// ============================================

model EmployerProfile {
  id             BigInt   @id
  company_name   String?  @db.VarChar(200)
  company_number String?  @db.VarChar(20)
  team_size      Int?     @db.SmallInt
  rating_avg     Decimal  @default(0) @db.Decimal(3, 2)
  rating_count   Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz()
  updated_at     DateTime @updatedAt @db.Timestamptz()

  client_profile ClientProfile @relation(fields: [id], references: [id], onDelete: Cascade)

  collaborations_as_employer Collaboration[] @relation("CollabEmployer")
  job_posts                  JobPost[]

  @@map("employer_profile")
}

// ============================================
// 6. STAFF MEMBER (shared PK = account.id)
// ============================================

model StaffMember {
  id                BigInt    @id
  display_name      String    @db.VarChar(100)
  staff_role        String    @db.VarChar(20)
  is_on_duty        Boolean   @default(false)
  invite_expires_at DateTime? @db.Timestamptz()
  created_at        DateTime  @default(now()) @db.Timestamptz()

  account              Account                 @relation(fields: [id], references: [id], onDelete: Cascade)
  moderation_actions   ModerationAction[]
  assigned_documents   Document[]              @relation("DocumentAssignee")
  reviewed_documents   Document[]              @relation("DocumentReviewer")
  verification_actions VerificationMilestone[]
  resolved_disputes    EscrowDispute[]
  platform_settings    PlatformSetting[]

  @@index([is_on_duty])
  @@map("staff_member")
}

// ============================================
// 7. DOCUMENT (file storage -> client_profile)
// ============================================

model Document {
  id                BigInt    @id @default(autoincrement())
  client_profile_id BigInt
  doc_type          String    @db.VarChar(40)
  file_url          String    @db.VarChar(500)
  status            String    @default("PENDING") @db.VarChar(20)
  rejection_reason  String?   @db.VarChar(500)
  metadata          Json?
  assigned_to       BigInt?
  reviewed_by       BigInt?
  reviewed_at       DateTime? @db.Timestamptz()
  created_at        DateTime  @default(now()) @db.Timestamptz()

  client_profile           ClientProfile           @relation(fields: [client_profile_id], references: [id], onDelete: Cascade)
  assignee                 StaffMember?            @relation("DocumentAssignee", fields: [assigned_to], references: [id])
  reviewer                 StaffMember?            @relation("DocumentReviewer", fields: [reviewed_by], references: [id])
  moderation_items         ModerationItem[]
  portfolio_item_documents PortfolioItemDocument[]

  @@index([client_profile_id, status])
  @@index([status, created_at])
  @@index([assigned_to, status])
  @@map("document")
}

// ============================================
// 8. MODERATION ITEM (staff work queue)
// ============================================

model ModerationItem {
  id          BigInt   @id @default(autoincrement())
  document_id BigInt?
  entity_type String   @db.VarChar(30)
  entity_id   BigInt
  queue_type  String   @db.VarChar(20)
  priority    Int      @default(5) @db.SmallInt
  status      String   @default("OPEN") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @updatedAt @db.Timestamptz()

  document           Document?          @relation(fields: [document_id], references: [id])
  moderation_actions ModerationAction[]

  @@index([queue_type, status, priority])
  @@index([entity_type, entity_id])
  @@map("moderation_item")
}

// ============================================
// 9. MODERATION ACTION (audit trail)
// ============================================

model ModerationAction {
  id                 BigInt   @id @default(autoincrement())
  moderation_item_id BigInt
  staff_member_id    BigInt
  action_type        String   @db.VarChar(20)
  notes              String?
  created_at         DateTime @default(now()) @db.Timestamptz()

  moderation_item ModerationItem @relation(fields: [moderation_item_id], references: [id], onDelete: Cascade)
  staff_member    StaffMember    @relation(fields: [staff_member_id], references: [id])

  @@index([moderation_item_id])
  @@map("moderation_action")
}

// ============================================
// 10. SPECIALISATION (reference data)
// ============================================

model Specialisation {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  worker_specialisations   WorkerSpecialisation[]
  job_post_specialisations JobPostSpecialisation[]

  @@map("specialisation")
}

model WorkerSpecialisation {
  worker_id         BigInt
  specialisation_id Int
  is_primary        Boolean @default(false)

  worker_profile WorkerProfile  @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  specialisation Specialisation @relation(fields: [specialisation_id], references: [id], onDelete: Cascade)

  @@id([worker_id, specialisation_id])
  @@index([specialisation_id])
  @@map("worker_specialisation")
}

// ============================================
// 11. PORTFOLIO ITEM (base for subtypes)
// ============================================

model PortfolioItem {
  id          BigInt    @id @default(autoincrement())
  worker_id   BigInt
  item_type   String    @db.VarChar(20)
  title       String    @db.VarChar(200)
  description String?
  sort_order  Int       @default(0) @db.SmallInt
  verified    Boolean   @default(false)
  verified_by String?   @db.VarChar(20)
  verified_at DateTime? @db.Timestamptz()
  created_at  DateTime  @default(now()) @db.Timestamptz()
  updated_at  DateTime  @updatedAt @db.Timestamptz()

  worker_profile WorkerProfile @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  experience_detail        ExperienceDetail?
  project_detail           ProjectDetail?
  certification_detail     CertificationDetail?
  portfolio_media          PortfolioMedia[]
  portfolio_item_documents PortfolioItemDocument[]

  @@index([worker_id, sort_order])
  @@map("portfolio_item")
}

// ============================================
// 12. EXPERIENCE DETAIL (shared PK = portfolio_item.id)
// ============================================

model ExperienceDetail {
  id           BigInt    @id
  company_name String?   @db.VarChar(200)
  role         String?   @db.VarChar(150)
  start_date   DateTime? @db.Timestamptz()
  end_date     DateTime? @db.Timestamptz()

  portfolio_item PortfolioItem @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("experience_detail")
}

// ============================================
// 13. PROJECT DETAIL (shared PK = portfolio_item.id)
// ============================================

model ProjectDetail {
  id            BigInt    @id
  project_type  String?   @db.VarChar(100)
  site_postcode String?   @db.VarChar(10)
  completed_at  DateTime? @db.Timestamptz()
  project_value Decimal?  @db.Decimal(12, 2)

  portfolio_item PortfolioItem @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("project_detail")
}

// ============================================
// 14. CERTIFICATION DETAIL (shared PK = portfolio_item.id)
// ============================================

model CertificationDetail {
  id           BigInt    @id
  cert_type    String    @db.VarChar(100)
  cert_number  String?   @db.VarChar(100)
  issuing_body String?   @db.VarChar(200)
  issued_at    DateTime? @db.Timestamptz()
  expires_at   DateTime? @db.Timestamptz()

  portfolio_item PortfolioItem @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("certification_detail")
}

// ============================================
// 15. PORTFOLIO MEDIA
// ============================================

model PortfolioMedia {
  id                BigInt   @id @default(autoincrement())
  portfolio_item_id BigInt
  media_url         String   @db.VarChar(500)
  caption           String?  @db.VarChar(300)
  sort_order        Int      @default(0) @db.SmallInt
  created_at        DateTime @default(now()) @db.Timestamptz()

  portfolio_item PortfolioItem @relation(fields: [portfolio_item_id], references: [id], onDelete: Cascade)

  @@index([portfolio_item_id, sort_order])
  @@map("portfolio_media")
}

// ============================================
// 16. PORTFOLIO ITEM DOCUMENT (M:M junction)
// ============================================

model PortfolioItemDocument {
  portfolio_item_id BigInt
  document_id       BigInt

  portfolio_item PortfolioItem @relation(fields: [portfolio_item_id], references: [id], onDelete: Cascade)
  document       Document      @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@id([portfolio_item_id, document_id])
  @@map("portfolio_item_document")
}

// ============================================
// 17. VERIFICATION MILESTONE
// ============================================

model VerificationMilestone {
  id                BigInt    @id @default(autoincrement())
  client_profile_id BigInt
  milestone_type    String    @db.VarChar(40)
  staff_member_id   BigInt?
  achieved_at       DateTime  @default(now()) @db.Timestamptz()
  expires_at        DateTime? @db.Timestamptz()
  evidence_ref      String?   @db.VarChar(500)
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz()

  client_profile ClientProfile @relation(fields: [client_profile_id], references: [id], onDelete: Cascade)
  actor          StaffMember?  @relation(fields: [staff_member_id], references: [id])

  @@index([client_profile_id])
  @@index([client_profile_id, milestone_type])
  @@map("verification_milestone")
}

// ============================================
// 20. COLLABORATION (relationship binding only)
// ============================================

model Collaboration {
  id                  BigInt    @id @default(autoincrement())
  worker_id           BigInt
  employer_id         BigInt
  last_contract_id    BigInt?
  first_contracted_at DateTime? @db.Timestamptz()
  created_at          DateTime  @default(now()) @db.Timestamptz()
  updated_at          DateTime  @updatedAt @db.Timestamptz()

  worker        WorkerProfile   @relation("CollabWorker", fields: [worker_id], references: [id])
  employer      EmployerProfile @relation("CollabEmployer", fields: [employer_id], references: [id])
  last_contract Contract?       @relation("CollabLastContract", fields: [last_contract_id], references: [id])

  contracts    Contract[]    @relation("CollabContracts")
  conversation Conversation?

  @@index([worker_id])
  @@index([employer_id])
  @@map("collaboration")
}

// ============================================
// 20b. CONTRACT (lifecycle entity, N per Collaboration)
// ============================================

model Contract {
  id                    BigInt    @id @default(autoincrement())
  collaboration_id      BigInt
  position              Int
  status                String    @default("DRAFT") @db.VarChar(20)
  // DRAFT / PROPOSED / ACTIVE / ENDED
  end_reason            String?   @db.VarChar(20)
  // COMPLETED / CANCELED / ABANDONED / DISPUTED_LOST (set only when status=ENDED)
  agreed_amount         Decimal?  @db.Decimal(12, 2)
  project_type          String?   @db.VarChar(100)
  site_postcode         String?   @db.VarChar(10)
  job_post_id           BigInt?
  initiated_by          String    @db.VarChar(10)
  project_referrer_id   BigInt?
  project_referrer_role String?   @db.VarChar(10)
  // WORKER (W2W) | EMPLOYER (E2E)
  started_at            DateTime? @db.Timestamptz()
  ended_at              DateTime? @db.Timestamptz()
  created_at            DateTime  @default(now()) @db.Timestamptz()
  updated_at            DateTime  @updatedAt @db.Timestamptz()

  collaboration    Collaboration   @relation("CollabContracts", fields: [collaboration_id], references: [id], onDelete: Restrict)
  job_post         JobPost?        @relation(fields: [job_post_id], references: [id])
  project_referrer Account?        @relation("ContractProjectReferrer", fields: [project_referrer_id], references: [id])

  collab_last_in           Collaboration[]         @relation("CollabLastContract")
  reviews                  Review[]
  escrow_transaction       EscrowTransaction?
  pending_referral_payouts PendingReferralPayout[]

  @@unique([collaboration_id, position])
  @@index([status])
  @@index([project_referrer_id])
  @@map("contract")
}

// ============================================
// 21. REVIEW (max 2 per contract)
// ============================================

model Review {
  id                   BigInt    @id @default(autoincrement())
  contract_id          BigInt
  reviewer_role        String    @db.VarChar(10)
  overall_rating       Int       @db.SmallInt
  quality_rating       Int?      @db.SmallInt
  reliability_rating   Int?      @db.SmallInt
  communication_rating Int?      @db.SmallInt
  payment_rating       Int?      @db.SmallInt
  safety_rating        Int?      @db.SmallInt
  comment              String?
  is_published         Boolean   @default(false)
  published_at         DateTime? @db.Timestamptz()
  created_at           DateTime  @default(now()) @db.Timestamptz()

  contract Contract @relation(fields: [contract_id], references: [id])

  @@unique([contract_id, reviewer_role])
  @@index([contract_id])
  @@map("review")
}

// ============================================
// 22. ESCROW TRANSACTION (1:0..1 with collaboration)
// ============================================

model EscrowTransaction {
  id                       BigInt    @id @default(autoincrement())
  contract_id              BigInt    @unique
  status                   String    @default("CREATED") @db.VarChar(20)
  job_amount               Decimal   @db.Decimal(12, 2)
  platform_fee             Decimal   @db.Decimal(12, 2)
  referral_commission      Decimal   @default(0) @db.Decimal(12, 2)
  worker_payout            Decimal   @db.Decimal(12, 2)
  currency                 String    @default("GBP") @db.VarChar(3)
  stripe_payment_intent_id String?   @unique @db.VarChar(200)
  stripe_charge_id         String?   @unique @db.VarChar(200)
  stripe_transfer_id       String?   @unique @db.VarChar(200)
  stripe_refund_id         String?   @db.VarChar(200)
  deposit_confirmed_at     DateTime? @db.Timestamptz()
  released_at              DateTime? @db.Timestamptz()
  refunded_at              DateTime? @db.Timestamptz()
  disputed_at              DateTime? @db.Timestamptz()
  created_at               DateTime  @default(now()) @db.Timestamptz()
  updated_at               DateTime  @updatedAt @db.Timestamptz()

  contract   Contract          @relation(fields: [contract_id], references: [id])
  milestones EscrowMilestone[]

  @@map("escrow_transaction")
}

// ============================================
// 22b. ESCROW MILESTONE (Upwork-style milestone-based contract)
// ============================================

model EscrowMilestone {
  id                   BigInt    @id @default(autoincrement())
  escrow_id            BigInt
  position             Int
  title                String    @db.VarChar(200)
  description          String?   @db.VarChar(2000)
  amount               Decimal   @db.Decimal(12, 2)
  status               String    @default("PENDING") @db.VarChar(20)
  // REQUESTED (worker proposed, awaiting employer approval) / PENDING (approved, employer can fund)
  // / FUNDED / SUBMITTED / RELEASED / DISPUTED / REFUNDED / CANCELED / RELEASE_FAILED
  created_by_role      String    @default("EMPLOYER") @db.VarChar(10)
  // EMPLOYER (default) | WORKER (worker requested)
  submission_message   String?   @db.VarChar(2000)
  worker_submitted_at  DateTime? @db.Timestamptz()
  employer_approved_at DateTime? @db.Timestamptz()
  released_at          DateTime? @db.Timestamptz()
  refunded_at          DateTime? @db.Timestamptz()
  disputed_at          DateTime? @db.Timestamptz()
  release_attempts     Int       @default(0)
  refund_reason        String?   @db.VarChar(500)
  // Frozen at fund-time (so admin fee changes don't retroactively change in-flight)
  frozen_client_fee_pct       Decimal? @db.Decimal(5, 2)
  frozen_freelancer_fee_pct   Decimal? @db.Decimal(5, 2)
  frozen_referral_fee_pct     Decimal? @db.Decimal(5, 2)
  frozen_worker_payout        Decimal? @db.Decimal(12, 2)
  frozen_referral_commission  Decimal? @db.Decimal(12, 2)
  frozen_platform_fee         Decimal? @db.Decimal(12, 2)
  stripe_pi_id          String?   @unique @db.VarChar(200)
  stripe_charge_id      String?   @unique @db.VarChar(200)
  stripe_transfer_id    String?   @unique @db.VarChar(200)
  stripe_refund_id      String?   @db.VarChar(200)
  created_at            DateTime  @default(now()) @db.Timestamptz()
  updated_at            DateTime  @updatedAt @db.Timestamptz()

  escrow                    EscrowTransaction         @relation(fields: [escrow_id], references: [id], onDelete: Cascade)
  dispute                   EscrowDispute?
  pending_referral_payouts  PendingReferralPayout[]
  pending_worker_payouts    PendingWorkerPayout[]
  attachments               EscrowMilestoneAttachment[]

  @@unique([escrow_id, position])
  @@index([status])
  @@index([escrow_id])
  @@map("escrow_milestone")
}

// ============================================
// 22b-A. ESCROW MILESTONE ATTACHMENT
// Up to 3 attachments per milestone, two phases:
//   - CREATION: added when the milestone is created (by employer or worker)
//   - SUBMISSION: added by worker when submitting work for review
// ============================================

model EscrowMilestoneAttachment {
  id             BigInt   @id @default(autoincrement())
  milestone_id   BigInt
  uploaded_by_id BigInt
  phase          String   @db.VarChar(15)
  // CREATION | SUBMISSION
  file_url       String   @db.VarChar(500)
  original_name  String   @db.VarChar(255)
  mime_type      String   @db.VarChar(100)
  size_bytes     Int
  created_at     DateTime @default(now()) @db.Timestamptz()

  milestone EscrowMilestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)
  uploader  ClientProfile   @relation("MilestoneAttachmentUploader", fields: [uploaded_by_id], references: [id])

  @@index([milestone_id])
  @@index([uploaded_by_id])
  @@map("escrow_milestone_attachment")
}

// ============================================
// 22b-B. PENDING WORKER PAYOUT
// Worker payout was authorised by employer (milestone RELEASED) but the
// worker hasn't completed Stripe Connect onboarding yet, so the money
// stays in the platform balance. Swept on `account.updated → payouts_enabled`.
// ============================================

model PendingWorkerPayout {
  id                       BigInt    @id @default(autoincrement())
  worker_client_profile_id BigInt
  milestone_id             BigInt
  amount                   Decimal   @db.Decimal(12, 2)
  currency                 String    @default("GBP") @db.VarChar(3)
  status                   String    @default("PENDING") @db.VarChar(20)
  // PENDING / PAID / FAILED / CANCELED
  stripe_transfer_id       String?   @db.VarChar(200)
  failure_reason           String?   @db.VarChar(500)
  created_at               DateTime  @default(now()) @db.Timestamptz()
  paid_at                  DateTime? @db.Timestamptz()

  worker    ClientProfile   @relation("WorkerPayoutWorker", fields: [worker_client_profile_id], references: [id])
  milestone EscrowMilestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@index([worker_client_profile_id, status])
  @@map("pending_worker_payout")
}

// ============================================
// 22c. PLATFORM SETTING (singleton row, admin-controlled fees)
// ============================================

model PlatformSetting {
  id                              Int      @id @default(1)
  client_marketplace_fee_percent  Decimal  @default(5.0)   @db.Decimal(5, 2)
  freelancer_service_fee_percent  Decimal  @default(10.0)  @db.Decimal(5, 2)
  account_referral_pct            Decimal  @default(10.00) @db.Decimal(5, 2)
  account_referral_window_months  Int?     @default(12)
  // NULL = lifetime
  project_referral_w2w_pct        Decimal  @default(2.00)  @db.Decimal(5, 2)
  project_referral_e2e_pct        Decimal  @default(2.00)  @db.Decimal(5, 2)
  stripe_fee_passthrough          String   @default("EMPLOYER_PAYS") @db.VarChar(20)
  // EMPLOYER_PAYS / PLATFORM_ABSORBS / WORKER_ABSORBS
  updated_at                      DateTime @updatedAt @db.Timestamptz()
  updated_by                      BigInt?

  updater StaffMember? @relation(fields: [updated_by], references: [id])

  @@map("platform_setting")
}

// ============================================
// 22d. ESCROW DISPUTE (per-milestone)
// ============================================

model EscrowDispute {
  id                    BigInt    @id @default(autoincrement())
  milestone_id          BigInt    @unique
  filed_by              BigInt
  reason                String    @db.VarChar(2000)
  status                String    @default("OPEN") @db.VarChar(20)
  // OPEN / RESPONDED / MEDIATION / RESOLVED / ARBITRATION_PENDING (extensibility for CIArb)
  response              String?   @db.VarChar(2000)
  responded_at          DateTime? @db.Timestamptz()
  resolution            Json?
  arbitration_required  Boolean   @default(false)
  resolved_by           BigInt?
  resolved_at           DateTime? @db.Timestamptz()
  resolution_reasoning  String?   @db.VarChar(2000)
  created_at            DateTime  @default(now()) @db.Timestamptz()
  updated_at            DateTime  @updatedAt @db.Timestamptz()

  milestone EscrowMilestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)
  filer     ClientProfile   @relation("DisputeFiler", fields: [filed_by], references: [id])
  resolver  StaffMember?    @relation(fields: [resolved_by], references: [id])

  @@index([status])
  @@map("escrow_dispute")
}

// ============================================
// 22e. PENDING REFERRAL PAYOUT (referrer not yet onboarded)
// ============================================

model PendingReferralPayout {
  id                          BigInt    @id @default(autoincrement())
  referrer_client_profile_id  BigInt
  milestone_id                BigInt
  contract_id                 BigInt?
  type                        String    @db.VarChar(20)
  // ACCOUNT / PROJECT_W2W / PROJECT_E2E
  amount                      Decimal   @db.Decimal(12, 2)
  currency                    String    @default("GBP") @db.VarChar(3)
  status                      String    @default("PENDING") @db.VarChar(20)
  // PENDING / PAID / FAILED / CANCELED
  stripe_transfer_id          String?   @db.VarChar(200)
  failure_reason              String?   @db.VarChar(500)
  created_at                  DateTime  @default(now()) @db.Timestamptz()
  paid_at                     DateTime? @db.Timestamptz()

  referrer  ClientProfile   @relation("ReferralPayoutReferrer", fields: [referrer_client_profile_id], references: [id])
  milestone EscrowMilestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)
  contract  Contract?       @relation(fields: [contract_id], references: [id])

  @@index([referrer_client_profile_id, status])
  @@map("pending_referral_payout")
}

// ============================================
// 23. SUBSCRIPTION PLAN (inactive by default)
// ============================================

model SubscriptionPlan {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(50)
  price_monthly Decimal  @db.Decimal(8, 2)
  price_yearly  Decimal? @db.Decimal(8, 2)
  max_referrals Int?
  features      Json     @default("{}")
  is_active     Boolean  @default(false)

  user_subscriptions UserSubscription[]

  @@map("subscription_plan")
}

// ============================================
// 24. USER SUBSCRIPTION
// ============================================

model UserSubscription {
  id                   BigInt    @id @default(autoincrement())
  client_profile_id    BigInt
  plan_id              Int
  stripe_sub_id        String?   @db.VarChar(100)
  status               String    @default("active") @db.VarChar(20)
  is_current           Boolean   @default(true)
  current_period_start DateTime? @db.Timestamptz()
  current_period_end   DateTime? @db.Timestamptz()
  created_at           DateTime  @default(now()) @db.Timestamptz()

  client_profile ClientProfile    @relation(fields: [client_profile_id], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [plan_id], references: [id])

  @@index([client_profile_id, is_current])
  @@map("user_subscription")
}

// ============================================
// 25. NOTIFICATION
// ============================================

model Notification {
  id         BigInt    @id @default(autoincrement())
  account_id BigInt
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(200)
  body       String?
  data       Json      @default("{}")
  read_at    DateTime? @db.Timestamptz()
  channel    String    @default("IN_APP") @db.VarChar(10)
  sent_at    DateTime? @db.Timestamptz()
  created_at DateTime  @default(now()) @db.Timestamptz()

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id, created_at(sort: Desc)])
  @@map("notification")
}

// ============================================
// 26. AUDIT LOG
// ============================================

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  account_id  BigInt?
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(50)
  entity_id   BigInt?
  metadata    Json     @default("{}")
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.Timestamptz()

  account Account? @relation(fields: [account_id], references: [id])

  @@index([account_id, created_at(sort: Desc)])
  @@map("audit_log")
}

// ============================================
// 27. TAG (reference data)
// ============================================

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  worker_tags   WorkerTag[]
  job_post_tags JobPostTag[]

  @@map("tag")
}

model WorkerTag {
  worker_id BigInt
  tag_id    Int

  worker_profile WorkerProfile @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  tag            Tag           @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([worker_id, tag_id])
  @@index([tag_id])
  @@map("worker_tag")
}

// ============================================
// 28. JOB POST
// ============================================

model JobPost {
  id            BigInt    @id @default(autoincrement())
  employer_id   BigInt
  title         String    @db.VarChar(200)
  description   String?
  postcode_area String?   @db.VarChar(10)
  site_address  String?   @db.VarChar(300)
  pay_type      String    @db.VarChar(15)
  day_rate_min  Decimal?  @db.Decimal(8, 2)
  day_rate_max  Decimal?  @db.Decimal(8, 2)
  fixed_price   Decimal?  @db.Decimal(12, 2)
  duration_days Int?
  start_date    DateTime? @db.Timestamptz()
  status        String    @default("OPEN") @db.VarChar(20)
  is_urgent     Boolean   @default(false)
  expires_at    DateTime? @db.Timestamptz()
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @updatedAt @db.Timestamptz()

  employer        EmployerProfile         @relation(fields: [employer_id], references: [id])
  specialisations JobPostSpecialisation[]
  tags            JobPostTag[]
  applications    JobApplication[]
  contracts       Contract[]
  attachments     JobAttachment[]

  @@index([employer_id])
  @@index([status, postcode_area])
  @@map("job_post")
}

model JobPostSpecialisation {
  job_post_id       BigInt
  specialisation_id Int

  job_post       JobPost        @relation(fields: [job_post_id], references: [id], onDelete: Cascade)
  specialisation Specialisation @relation(fields: [specialisation_id], references: [id], onDelete: Cascade)

  @@id([job_post_id, specialisation_id])
  @@index([specialisation_id])
  @@map("job_post_specialisation")
}

model JobPostTag {
  job_post_id BigInt
  tag_id      Int

  job_post JobPost @relation(fields: [job_post_id], references: [id], onDelete: Cascade)
  tag      Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([job_post_id, tag_id])
  @@index([tag_id])
  @@map("job_post_tag")
}

// ============================================
// 29. JOB APPLICATION
// ============================================

model JobApplication {
  id                    BigInt    @id @default(autoincrement())
  job_post_id           BigInt
  worker_id             BigInt
  initiated_by          String    @db.VarChar(10)
  status                String    @default("PENDING") @db.VarChar(20)
  cover_message         String?
  proposed_rate         Decimal?  @db.Decimal(8, 2)
  project_referrer_id   BigInt?
  project_referrer_role String?   @db.VarChar(10)
  responded_at          DateTime? @db.Timestamptz()
  created_at            DateTime  @default(now()) @db.Timestamptz()
  updated_at            DateTime  @updatedAt @db.Timestamptz()

  job_post         JobPost         @relation(fields: [job_post_id], references: [id], onDelete: Cascade)
  worker_profile   WorkerProfile   @relation(fields: [worker_id], references: [id])
  project_referrer Account?        @relation("ApplicationProjectReferrer", fields: [project_referrer_id], references: [id])
  attachments      JobAttachment[]

  @@unique([job_post_id, worker_id])
  @@index([job_post_id, status])
  @@index([worker_id, status])
  @@index([project_referrer_id])
  @@map("job_application")
}

// ============================================
// 29b. JOB ATTACHMENT (polymorphic — exactly one of job_post_id /
// job_application_id is non-null when attached; both NULL = orphan
// pending the 48 h cron sweep)
// ============================================

model JobAttachment {
  id                 BigInt   @id @default(autoincrement())
  uploaded_by_id     BigInt
  job_post_id        BigInt?
  job_application_id BigInt?
  file_url           String   @db.VarChar(500)
  original_name      String   @db.VarChar(255)
  mime_type          String   @db.VarChar(100)
  size_bytes         Int
  created_at         DateTime @default(now()) @db.Timestamptz()

  uploader        ClientProfile   @relation(fields: [uploaded_by_id], references: [id], onDelete: Cascade)
  job_post        JobPost?        @relation(fields: [job_post_id], references: [id], onDelete: Cascade)
  job_application JobApplication? @relation(fields: [job_application_id], references: [id], onDelete: Cascade)

  @@index([uploaded_by_id])
  @@index([job_post_id])
  @@index([job_application_id])
  @@index([created_at])
  @@map("job_attachment")
}

// ============================================
// 30. CONVERSATION & MESSAGES
// ============================================

model Conversation {
  id               BigInt    @id @default(autoincrement())
  collaboration_id BigInt?
  last_message_at  DateTime? @db.Timestamptz()
  created_at       DateTime  @default(now()) @db.Timestamptz()

  collaboration Collaboration?            @relation(fields: [collaboration_id], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]

  @@unique([collaboration_id])
  @@map("conversation")
}

model ConversationParticipant {
  conversation_id BigInt
  account_id      BigInt
  last_read_at    DateTime? @db.Timestamptz()
  joined_at       DateTime  @default(now()) @db.Timestamptz()

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [account_id], references: [id], onDelete: Cascade)

  messages Message[]

  @@id([conversation_id, account_id])
  @@index([account_id])
  @@map("conversation_participant")
}

model Message {
  id              BigInt   @id @default(autoincrement())
  conversation_id BigInt
  sender_id       BigInt
  content         String
  message_type    String   @default("TEXT") @db.VarChar(20)
  metadata        Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz()

  conversation Conversation            @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  participant  ConversationParticipant @relation(fields: [conversation_id, sender_id], references: [conversation_id, account_id])
  attachments  MessageAttachment[]

  @@index([conversation_id, created_at])
  @@map("message")
}

// ============================================
// 30A. MESSAGE ATTACHMENT (file rows for chat — mirrors JobAttachment)
// ============================================

model MessageAttachment {
  id             BigInt   @id @default(autoincrement())
  message_id     BigInt?
  uploaded_by_id BigInt
  file_url       String   @db.VarChar(500)
  original_name  String   @db.VarChar(255)
  mime_type      String   @db.VarChar(100)
  size_bytes     Int
  created_at     DateTime @default(now()) @db.Timestamptz()

  message  Message?      @relation(fields: [message_id], references: [id], onDelete: Cascade)
  uploader ClientProfile @relation(fields: [uploaded_by_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([uploaded_by_id])
  @@index([created_at])
  @@map("message_attachment")
}
